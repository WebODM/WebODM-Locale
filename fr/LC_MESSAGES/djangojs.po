"temps de traitement par environ 4.Valeurs possibles : %(choices)s. Par "
"défaut : %(default)s"

#: app/static/app/js/translations/odm_autogenerated.js:59
#, python-format
msgid ""
"End processing at this stage. Can be one of: %(choices)s. Default: "
"%(default)s"
msgstr ""
"Arrêter le traitement à cette étape. Valeurs possibles : %(choices)s. Par "
