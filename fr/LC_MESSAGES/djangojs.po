#: app/static/app/js/translations/odm_autogenerated.js:55
#, python-format
msgid ""
"Do not use GPU acceleration, even if it's available. Default: %(default)s"
msgstr ""
"Ne pas utiliser l'accélération GPU, même si elle est disponible. Par défaut "
": %(default)s"

#: app/static/app/js/translations/odm_autogenerated.js:56
#, python-format
msgid ""
"Simple Morphological Filter elevation threshold parameter (meters). Default: "
