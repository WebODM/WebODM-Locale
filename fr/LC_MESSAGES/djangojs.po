msgstr ""
"Exporter le nuage de points géo-référencé au format Entwine Point Tile "
"(EPT). Défaut : %(default)s"

#: app/static/app/js/translations/odm_autogenerated.js:47
#, python-format
msgid ""
"Set this parameter if you want to generate a Google Earth (KMZ) rendering of "
"the orthophoto. Default: %(default)s"
msgstr ""
"Activez ce paramètre si vous voulez générer un rendu Google Earth (KMZ) de "
