#: app/static/app/js/translations/odm_autogenerated.js:48
#, python-format
msgid ""
"Set the compression to use for orthophotos. Can be one of: %(choices)s. "
"Default: %(default)s"
msgstr ""
"Définit la compression à utiliser pour les orthophotos. Valeurs possibles : "
